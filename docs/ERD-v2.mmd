erDiagram
    USERS ||--o{ VENUES : owns
    USERS ||--o{ VENUE_MEMBERS : assigned
    VENUES ||--o{ VENUE_MEMBERS : has
    GOVERNORATES ||--o{ DISTRICTS : contains
    DISTRICTS ||--o{ AREAS : contains
    AREAS ||--o{ VENUES : located_in
    VENUES ||--o{ FIELDS : contains
    VENUES ||--o{ VENUE_IMAGES : has
    FIELDS ||--o{ FIELD_IMAGES : has
    FIELDS ||--o{ FIELD_AMENITIES : offers
    AMENITIES ||--o{ FIELD_AMENITIES : assigned
    FIELDS ||--o{ OPENING_HOURS : schedules
    FIELDS ||--o{ PRICING_RULES : prices
