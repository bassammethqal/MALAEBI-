# Environment & Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL / Supabase Session Pooler)
# For Supabase Session Pooler (port 5432 over IPv4):
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Set DATABASE_SSL=false for local PostgreSQL without SSL, or true for Supabase
DATABASE_SSL=true
# Set DATABASE_SSL_REJECT_UNAUTHORIZED=false if connecting via poolers with custom certificates
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Supabase Project Configuration (Auth & SDK)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# Publishable / Anon Key (for public client operations)
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Secret / Service Role Key (server-side administrative access only, keep secret)
SUPABASE_SECRET_KEY=your-supabase-secret-key

# PWA / Client Origins for CORS (comma-separated)
CORS_ORIGIN=http://localhost:4173,http://localhost:5173

# Note: Production requires configuring an approved Yemen-capable SMS provider in Supabase Auth before enabling OTP.
